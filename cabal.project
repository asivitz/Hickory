import: https://www.stackage.org/nightly-2026-10-09/cabal.config

packages:
  ./core
  ./GLFW
  ./SDL
  ./SDL3
  ./ImGUI
  ./iOS
  ./FRP
  ./Example/Shooter
  ./Example/Showcase

package dear-imgui
  flags: -opengl3 +vulkan -sdl +sdl3 -glfw

constraints:
  wavefront ==0.7.1.4,
  vulkan ==3.26.2,
  vulkan-utils ==0.5.10.6,
  VulkanMemoryAllocator ==0.11.0.1,
  derive-storable ==0.3.1.0,
  acquire ==0.3.6

source-repository-package
  type: git
  location: https://github.com/asivitz/dear-imgui.hs.git
  tag: 087294ff19a5fb24f9dce14f52b3adadb405b671

source-repository-package
  type: git
  location: https://github.com/fieldstrength/aeson-deriving.git
  tag: e6e1f5066ebf1f37c10687e9bc90e5b0d3b22b0c

source-repository-package
  type: git
  location: https://github.com/asivitz/haskell-gltf-loader.git
  tag: d6ab71bd3de13a2d71ebc9f66041bdee98eae922

source-repository-package
  type: git
  location: https://github.com/asivitz/sdl3-hs.git
  tag: 9067bbc1c7732e79649c943af04f6c5b32007022

extra-lib-dirs:
  /usr/local/lib

allow-newer: all
